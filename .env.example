# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=metalinv.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# postgres = production / normal dev. sqlite = quick dev-only fallback.
DB_ENGINE=postgres
DB_NAME=metalinv
DB_USER=metalinv
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Auth tokens
# ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# Browser origins (comma separated, no spaces)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production only
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
